# Supabase — you can reuse your existing TELPSAM project's values, or a new one.
# Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# SECRET — server-only. Used by the admin page to read all registrations past RLS.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Password that protects the /admin registrations list. Choose a strong value.
ADMIN_PASSWORD=

# Optional: your site's base URL (used in metadata / links).
NEXT_PUBLIC_APP_URL=https://registration.telpsam.com
